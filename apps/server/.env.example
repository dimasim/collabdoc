# Server Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/collabdoc?schema=public"

# Authentication (JWT)
# Pastikan ganti secret ini dengan random string minimal 32 karakter di production
JWT_ACCESS_SECRET="collabdoc_super_secret_access_jwt_key_32chars_min"
JWT_REFRESH_SECRET="collabdoc_super_secret_refresh_jwt_key_32chars_min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS & Client URL
FRONTEND_URL="http://localhost:3000"
